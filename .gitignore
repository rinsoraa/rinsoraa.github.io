# 本地开发用，不上传
.vscode/
__pycache__/
*.pyc

# 本地回归装置临时产物（_shot.py / _v2.py 会把注入探针的页面写进站点根目录，
# 中途被 Ctrl-C / 超时中断就会残留），绝不能跟着推上去
_shot_*.html
_probe_*.html
*.probe.html
_gap_*.html

# Local phase archives / raw browser captures. Keep reports and test sources
# reviewable; retain the ignored evidence on disk and in external checkpoints.
docs/**/*.zip
docs/**/stage/
docs/**/screenshots*/
docs/**/raw-traces/
docs/**/tooling/
docs/**/*.har
docs/**/lighthouse*/
# Raw phase captures/logs also exist outside named screenshot directories.
# They stay in the verified local archives, not in a broad Git staging action.
docs/**/*.png
docs/**/*.jpg
docs/**/*.log
# Original browser recordings remain in verified local evidence archives.
docs/**/originals/*.webm
docs/**/originals/*.mp4
node_modules/
